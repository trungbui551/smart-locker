# Sao chép thành .env rồi sửa. File .env KHÔNG được commit lên GitHub.

# Cơ sở dữ liệu PostgreSQL (Docker local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=locker
POSTGRES_USER=locker
POSTGRES_PASSWORD=locker

# Giao tiếp MQTT với tủ khóa
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=

# Khóa bí mật cho OTP và JWT: tự sinh chuỗi dài ngẫu nhiên (không dùng change-me khi demo công khai)
OTP_SECRET=change-me
JWT_SECRET=change-me

# Gửi Email thật (Gmail SMTP App Password — cấu hình ở mốc M1/M3)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Gửi SMS thật bản dùng thử (Twilio/eSMS — cấu hình ở mốc M3)
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=
