# Sao chép thành .env rồi sửa. File .env KHÔNG được commit lên GitHub.

# Cơ sở dữ liệu PostgreSQL (Docker local — dùng 5433 nếu máy đã cài sẵn PostgreSQL trên 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=locker
POSTGRES_USER=locker
POSTGRES_PASSWORD=locker

# Giao tiếp MQTT với tủ khóa
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=

# Khóa bí mật cho OTP và JWT: tự sinh chuỗi dài ngẫu nhiên (>= 32 ký tự)
OTP_SECRET=change-me
JWT_SECRET=change-me

# Chế độ gửi Email: log (chưa gửi thật, chỉ ghi trạng thái) | smtp (Gmail App Password) | oauth2 (Google OAuth 2)
MAIL_MODE=log
MAIL_FROM=

# Cấu hình nếu dùng MAIL_MODE=smtp (Gmail App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Cấu hình nếu dùng MAIL_MODE=oauth2 (Google OAuth 2 Gmail API)
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Gửi SMS thật bản dùng thử (Twilio/eSMS — cấu hình ở mốc M3)
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=
